# Normalize text to LF in the repository and working tree on every platform. This matches
# `.editorconfig` and prevents formatter-only diffs between Windows and Linux CI.
* text=auto eol=lf

# C# source
*.cs text diff=csharp

# Project files
*.csproj text
*.props text
*.targets text

# Config / data formats
*.json text
*.yml text
*.yaml text
*.xml text

# Markdown
*.md text

# Scripts
*.sh text eol=lf
*.ps1 text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Security reports
*.sarif text
