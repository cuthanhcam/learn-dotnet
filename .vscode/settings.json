{
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.exclude": {
        "**/bin": true,
        "**/obj": true,
        "**/TestResults": true,
        "artifacts": true
    },
    "files.watcherExclude": {
        "**/bin/**": true,
        "**/obj/**": true,
        "**/TestResults/**": true,
        "artifacts/**": true
    },
    "search.exclude": {
        "**/bin": true,
        "**/obj": true,
        "**/TestResults": true,
        "artifacts": true,
        "legacy": true
    },
    "[csharp]": {
        "editor.defaultFormatter": "ms-dotnettools.csharp",
        "editor.formatOnSave": true
    },
    "dotnet.defaultSolution": "learn-dotnet.slnx"
}
